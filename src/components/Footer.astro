---
import { categories } from "../data/categories";
import SocialLinks from "./SocialLinks.astro";
const base = import.meta.env.BASE_URL;
const topicHref = (slug: string) => `${base}${slug === "software-development" ? "software-dev/" : slug === "artificial-intelligence" ? "ai/" : `categories/${slug}/`}`;
---
<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand-block">
      <a class="brand brand-footer" href={base}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="brand-word">Techno<span>Raise</span></span>
      </a>
      <p>Clear thinking for a world shaped by technology.</p>
      <span class="footer-manifesto">Elevate Ideas. Empower the Future.</span>
      <SocialLinks />
    </div>
    <div class="footer-column">
      <h2>Explore</h2>
      <a href={`${base}articles/`}>All articles</a>
      <a href={`${base}categories/`}>All topics</a>
      <a href={`${base}about/`}>About TechnoRaise</a>
      <a href={`${base}editorial-policy/`}>Editorial policy</a>
      <a href={`${base}contact/`}>Contact</a>
    </div>
    <div class="footer-column">
      <h2>Topics</h2>
      {categories.map((category) => <a href={topicHref(category.slug)}>{category.name}</a>)}
    </div>
    <div class="footer-column">
      <h2>Information</h2>
      <a href={`${base}privacy-policy/`}>Privacy policy</a>
      <a href={`${base}terms-of-use/`}>Terms of use</a>
      <button class="footer-cookie-link" type="button" data-open-cookie-preferences>Cookie preferences</button>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} TechnoRaise. All rights reserved.</span>
    <span>Independent thinking. Practical technology.</span>
  </div>
</footer>
<script>
  document.querySelector("[data-open-cookie-preferences]")?.addEventListener("click", () => {
    window.dispatchEvent(new Event("technoraise:cookie-preferences"));
  });
</script>
