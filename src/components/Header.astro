---
import { categories } from "../data/categories";
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.startsWith(base) ? `/${Astro.url.pathname.slice(base.length)}` : Astro.url.pathname;
const topicHref = (slug: string) => `${base}${slug === "software-development" ? "software-dev/" : slug === "artificial-intelligence" ? "ai/" : `categories/${slug}/`}`;
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="TechnoRaise home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="brand-word">Techno<span>Raise</span></span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a class:list={["nav-link", { active: currentPath === "/" }]} href={base} aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
      <a class:list={["nav-link", { active: currentPath.startsWith("/articles/") }]} href={`${base}articles/`} aria-current={currentPath.startsWith("/articles/") ? "page" : undefined}>Articles</a>
      <div class="nav-dropdown">
        <a class:list={["nav-link", { active: currentPath.startsWith("/categories/") || currentPath === "/ai/" || currentPath === "/software-dev/" }]} href={`${base}categories/`}>Topics <span aria-hidden="true">⌄</span></a>
        <div class="dropdown-panel">
          {categories.map((category) => <a href={topicHref(category.slug)}>{category.name}</a>)}
        </div>
      </div>
      <a class:list={["nav-link", { active: currentPath === "/about/" }]} href={`${base}about/`}>About</a>
    </nav>
    <a class="header-cta" href={`${base}contact/`}>Get in touch <span aria-hidden="true">↗</span></a>
  </div>
</header>
