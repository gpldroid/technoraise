---
interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  url: string;
  heroImage: string;
}

const { title, description, pubDate, url, heroImage } = Astro.props;
const publicationDate = pubDate instanceof Date ? pubDate : new Date(pubDate);
const formattedPubDate = publicationDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

// Accept absolute URLs and root-relative or content-relative paths without
// accidentally adding the configured BASE_URL twice.
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const isAbsoluteImage = heroImage.startsWith("https://") || heroImage.startsWith("http://");
const imagePath = heroImage.startsWith("/") ? heroImage.slice(1) : heroImage;
const baseWithoutLeadingSlash = normalizedBase.startsWith("/") ? normalizedBase.slice(1) : normalizedBase;
const imageSrc = isAbsoluteImage
  ? heroImage
  : imagePath.startsWith(baseWithoutLeadingSlash)
    ? `/${imagePath}`
    : `${normalizedBase}${imagePath}`;
---

<a href={url} class="article-card">
  <article class="article-card-inner">
    <div class="article-card-image">
      <img
        src={imageSrc}
        alt={title}
        loading="lazy"
        decoding="async"
        width="1200"
        height="750"
      />
    </div>
    <div class="article-card-content">
      <p class="article-card-meta">
        <time datetime={publicationDate.toISOString()}>{formattedPubDate}</time>
      </p>
      <h3>{title}</h3>
      <p class="article-card-description">{description}</p>
      <span class="article-card-read-link">Read article <svg class="ui-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></span>
    </div>
  </article>
</a>
