---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  date?: Date;
  readingTime?: number;
}
const { title, description, href, category, date, readingTime } = Astro.props;
const formattedDate = date
  ? new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date)
  : undefined;
const articleHref = `${import.meta.env.BASE_URL}${href.replace(/^\/+/, "")}`;
---
<article class="article-card">
  <a class="article-card-link" href={articleHref}>
    <div class="article-card-meta">
      <span class="eyebrow">{category}</span>
      {formattedDate && <time>{formattedDate}</time>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="read-link">Read article <span aria-hidden="true">↗</span></span>
    {readingTime && <span class="reading-time">{readingTime} min read</span>}
  </a>
</article>
