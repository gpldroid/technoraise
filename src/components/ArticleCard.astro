---
interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  url: string;
  heroImage: string;
}

const { title, description, pubDate, url, heroImage } = Astro.props;
const publicationDate = pubDate instanceof Date ? pubDate : new Date(pubDate);
const formattedPubDate = publicationDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

// Accept absolute image URLs and both root-relative and content-relative paths.
// Avoid prefixing BASE_URL twice when callers already provide a BASE_URL path.
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const imagePath = heroImage.replace(/^\\/+/, "");
const imageSrc = /^https?:\\/\\//i.test(heroImage)
  ? heroImage
  : imagePath.startsWith(normalizedBase.replace(/^\\/+/, ""))
    ? `/${imagePath}`
    : `${normalizedBase}${imagePath}`;
---

<a href={url} class="article-card">
  <article>
    <div class="article-card-image">
      <img
        src={imageSrc}
        alt={title}
        loading="lazy"
        decoding="async"
        width="1200"
        height="750"
      />
    </div>

    <div class="article-card-content">
      <p class="article-card-meta">
        <time datetime={publicationDate.toISOString()}>{formattedPubDate}</time>
      </p>
      <h3>{title}</h3>
      <p class="article-card-description">{description}</p>
      <span class="article-card-read-link">Read article <span aria-hidden="true">↗</span></span>
    </div>
  </article>
</a>
