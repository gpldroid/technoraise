---
interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  url: string;
  heroImage: string;
}

const { title, description, pubDate, url, heroImage } = Astro.props;
const publicationDate = pubDate instanceof Date ? pubDate : new Date(pubDate);
const formattedPubDate = publicationDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const imageSrc = /^https?:\/\//.test(heroImage)
  ? heroImage
  : `${import.meta.env.BASE_URL}${heroImage.replace(/^\/+/, "")}`;
---

<a
  href={url}
  class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:shadow-lg"
>
  <article>
    <div class="aspect-[16/10] w-full overflow-hidden">
      <img
        src={imageSrc}
        alt={title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
      />
    </div>

    <div class="p-5 md:p-6">
      <p class="mb-2 text-fs-xs font-medium text-techno-teal">
        <time datetime={publicationDate.toISOString()}>{formattedPubDate}</time>
      </p>

      <h3 class="mb-2 line-clamp-2 text-fs-xl font-semibold leading-tight text-slate-900 transition-colors group-hover:text-techno-blue">
        {title}
      </h3>

      <p class="line-clamp-3 text-fs-sm leading-normal text-slate-600">
        {description}
      </p>
    </div>
  </article>
</a>
