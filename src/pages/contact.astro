---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact" description="Get in touch with TechnoRaise about editorial feedback, corrections, and collaboration.">
  <section class="prose-hero section-wrap">
    <span class="section-kicker">START A CONVERSATION</span>
    <h1>Good ideas grow through <em>conversation.</em></h1>
    <p class="prose-intro">Have a correction, a story idea, or feedback about something we've published? We'd like to hear from you.</p>
  </section>
  <section class="contact-note section-wrap">
    <span class="contact-symbol">↗</span>
    <div><h2>Editorial contact details are being prepared.</h2><p>A verified contact address will be published here before the site opens to submissions. We don't display an unmonitored or invented email address.</p></div>
  </section>
</BaseLayout>