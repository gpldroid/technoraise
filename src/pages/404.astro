---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="listing-hero section-wrap">
    <span class="section-kicker">404 / OFF THE MAP</span>
    <h1>This page took a <em>different route.</em></h1>
    <p>The page may have moved, or the address may be incorrect. Let's get you back to the ideas.</p>
    <a class="button button-primary" style="margin-top:28px" href="/">Return home <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>