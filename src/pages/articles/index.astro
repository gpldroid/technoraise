---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { categories } from "../../data/categories";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Articles" description="Explore TechnoRaise articles on software development, artificial intelligence, digital solutions, digital transformation, and technology news.">
  <section class="listing-hero section-wrap">
    <span class="section-kicker">THE READING ROOM</span>
    <h1>Ideas made to be <em>understood.</em></h1>
    <p>Reporting, practical guides, and considered perspectives on the technologies shaping how we work and live.</p>
  </section>
  <section class="listing-content section-wrap">
    {articles.length ? <div class="article-grid">{articles.map((article) => <ArticleCard title={article.data.title} description={article.data.description} href={`/articles/${article.id}/`} category={categories.find((item) => item.slug === article.data.category)?.name ?? article.data.category} date={article.data.pubDate} />)}</div> : <div class="editorial-empty"><span class="empty-mark">✳</span><div><h2>Our first stories are in the works.</h2><p>We're building a thoughtful library of technology writing. Visit the topics page to see what we'll be covering.</p></div><a href="/categories/">Explore topics <span aria-hidden="true">↗</span></a></div>}
  </section>
</BaseLayout>
