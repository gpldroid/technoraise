---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}
const { title, description, image, type, noindex = false } = Astro.props;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TechnoRaise",
  url: "https://technoraise.com/",
  description: "An independent English-language technology publication covering software development, artificial intelligence, digital solutions, digital transformation, and technology news.",
  logo: "https://technoraise.com/favicon.svg",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b2b" />
    <SeoHead title={title} description={description} image={image} type={type} noindex={noindex} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
