---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";
import "../styles/tailwind.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  slug?: string;
  noindex?: boolean;
}
const { title, description, image, type, slug, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site).toString();
const ogImage =
  type === "article" && slug
    ? new URL(`${base}og/${encodeURIComponent(slug)}.png`, Astro.site).toString()
    : image;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TechnoRaise",
  url: siteUrl,
  description: "An English-language technology publication covering software development, artificial intelligence, digital solutions, digital transformation, and technology news.",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101b2b" />
    <meta name="google-site-verification" content="bCaxiNDGk6j_tbXkQc80TSNqVjOe2oR16eMmmRZQMLA" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":
      new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!=="dataLayer"?"&l="+l:"";j.async=true;j.src=
      "https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,"script","dataLayer","GTM-W227L4KM");
    </script>
    <!-- End Google Tag Manager -->
    <SeoHead title={title} description={description} image={ogImage} imageAlt={title} type={type} noindex={noindex} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W227L4KM"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
