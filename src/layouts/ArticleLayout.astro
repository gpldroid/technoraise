---
import BaseLayout from "./BaseLayout.astro";
import { categories } from "../data/categories";

interface Props {
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  authorType?: "Person" | "Organization";
  image?: string;
}
const { title, description, category, pubDate, updatedDate, author, authorType = "Organization", image } = Astro.props;
const categoryName = categories.find((item) => item.slug === category)?.name ?? category;
const base = import.meta.env.BASE_URL;
const routePath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.startsWith("/") ? Astro.url.pathname.slice(1) : Astro.url.pathname;
const imageSrc = image ? (image.startsWith("http") ? image : `${base}${image.startsWith("/") ? image.slice(1) : image}`) : undefined;
const pageUrl = new URL(`${base}${routePath}`, Astro.site).toString();
const siteUrl = new URL(base, Astro.site).toString();
const datePublished = pubDate.toISOString();
const dateModified = (updatedDate ?? pubDate).toISOString();
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished,
  dateModified,
  author: { "@type": authorType, name: author },
  publisher: { "@type": "Organization", name: "TechnoRaise", url: siteUrl },
  mainEntityOfPage: pageUrl,
  ...(imageSrc ? { image: new URL(imageSrc, Astro.site).toString() } : {}),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: categoryName, item: new URL(`${base}categories/${category}/`, Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: pageUrl },
  ],
};
---
<BaseLayout title={title} description={description} image={image} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="article-shell">
    <div class="article-topline">
      <a href={`${base}categories/${category}/`}>{categoryName}</a>
      <span>•</span>
      <time datetime={datePublished}>{new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(pubDate)}</time>
    </div>
    <header class="article-heading">
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-byline">
        <span class="byline-avatar" aria-hidden="true">T</span>
        <span>By <strong>{author}</strong></span>
        {updatedDate && <span class="updated-note">Updated {new Intl.DateTimeFormat("en", { dateStyle: "medium", timeZone: "UTC" }).format(updatedDate)}</span>}
      </div>
    </header>
    {image && <img class="article-hero-image" src={imageSrc} alt="" fetchpriority="high" />}
    <div class="article-content"><slot /></div>
    <div class="article-endnote">
      <span class="endnote-symbol">✳</span>
      <p>Thoughtful technology starts with better questions. Explore more ideas across TechnoRaise.</p>
      <a href={`${base}articles/`}>Explore all articles <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</BaseLayout>
